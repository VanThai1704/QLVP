@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OfficePro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div class="app-wrapper">
        <aside class="app-sidebar" id="appSidebar">
            <div class="app-sidebar-brand">
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building"></i>
                    <span>
                        OfficePro
                        <small>Quản lý văn phòng cao ốc</small>
                    </span>
                </a>
            </div>
            <nav class="app-sidebar-nav">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Tổng quan
                </a>

                @if (User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Admin))
                {
                    <div class="nav-section-label">Vận hành tòa nhà</div>
                    <a class="nav-link" asp-controller="Offices" asp-action="Index"><i class="bi bi-door-open"></i> Văn phòng</a>
                    <a class="nav-link" asp-controller="Offices" asp-action="StatusBoard"><i class="bi bi-grid-3x3-gap"></i> Trạng thái phòng</a>
                    <a class="nav-link" asp-controller="ServiceTypes" asp-action="Index"><i class="bi bi-tags"></i> Danh mục dịch vụ</a>
                    <a class="nav-link" asp-controller="OfficeServices" asp-action="Index"><i class="bi bi-plug"></i> Dịch vụ theo VP</a>
                    <a class="nav-link" asp-controller="Tenants" asp-action="Index"><i class="bi bi-people"></i> Khách thuê</a>
                    <a class="nav-link" asp-controller="Employees" asp-action="Index"><i class="bi bi-person-badge"></i> Nhân viên</a>
                    <a class="nav-link" asp-controller="Contracts" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Hợp đồng</a>
                    <a class="nav-link" asp-controller="MaintenanceRequests" asp-action="Index"><i class="bi bi-tools"></i> Sửa chữa & bảo trì</a>
                }

                @if (User.IsInRole(AppRoles.Accountant) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Admin))
                {
                    <div class="nav-section-label">Tài chính</div>
                    <a class="nav-link" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i> Hóa đơn</a>
                    @if (User.IsInRole(AppRoles.Accountant) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                    {
                        <a class="nav-link" asp-controller="Invoices" asp-action="Create"><i class="bi bi-plus-circle"></i> Lập hóa đơn</a>
                    }
                    <a class="nav-link" asp-controller="Invoices" asp-action="Revenue"><i class="bi bi-bar-chart-line"></i> Thống kê doanh thu</a>
                }

                @if (User.IsInRole(AppRoles.Accountant))
                {
                    <a class="nav-link" asp-controller="MaintenanceRequests" asp-action="Index"><i class="bi bi-wrench"></i> Yêu cầu sửa chữa</a>
                }

                @if (User.IsInRole(AppRoles.Admin))
                {
                    <div class="nav-section-label">Hệ thống</div>
                    <a class="nav-link" asp-controller="Accounts" asp-action="Index"><i class="bi bi-shield-lock"></i> Tài khoản</a>
                }

                @if (User.IsInRole(AppRoles.Tenant))
                {
                    <div class="nav-section-label">Khách thuê</div>
                    <a class="nav-link" asp-controller="Offices" asp-action="Browse"><i class="bi bi-door-open"></i> Văn phòng cho thuê</a>
                    <a class="nav-link" asp-controller="Contracts" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Hợp đồng của tôi</a>
                    <a class="nav-link" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i> Hóa đơn của tôi</a>
                    <a class="nav-link" asp-controller="MaintenanceRequests" asp-action="Index"><i class="bi bi-tools"></i> Yêu cầu sửa chữa</a>
                }

                @if (User.IsInRole(AppRoles.Technician))
                {
                    <div class="nav-section-label">Kỹ thuật</div>
                    <a class="nav-link" asp-controller="MaintenanceRequests" asp-action="Index"><i class="bi bi-clipboard-check"></i> Công việc được giao</a>
                }
            </nav>
        </aside>

        <div class="app-content">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="app-topbar-title">@ViewData["Title"]</span>
                </div>
                <div class="app-topbar-user">
                    <span class="user-badge">@VietnameseLabels.Role(role)</span>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-person-circle"></i> @User.Identity.Name
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-box-arrow-right"></i> Thoát
                        </button>
                    </form>
                </div>
            </header>

            <main class="app-main">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 OfficePro — Hệ thống quản lý văn phòng cao ốc
            </footer>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model OfficeService
@{
    ViewData["Title"] = "Gán dịch vụ";
    var offices = ViewBag.Offices as IEnumerable<Office>;
    var serviceTypes = ViewBag.ServiceTypes as IEnumerable<ServiceType>;
}
<h2>Gán dịch vụ cho văn phòng</h2>
<form asp-action="Create" method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Văn phòng</label>
        <select asp-for="OfficeId" class="form-select" asp-items="@(new SelectList(offices, "Id", "Name"))"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Loại dịch vụ</label>
        <select asp-for="ServiceTypeId" class="form-select" asp-items="@(new SelectList(serviceTypes, "Id", "Name"))"></select>
    </div>
    <div class="mb-3"><label asp-for="UnitPrice" class="form-label">Đơn giá (VNĐ)</label><input asp-for="UnitPrice" class="form-control" /></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" checked /><label asp-for="IsActive" class="form-check-label">Đang áp dụng</label></div>
    <button class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@model BankTransferViewModel
@{ ViewData["Title"] = "Thanh toán chuyển khoản"; }

<div class="page-header">
    <h1>Thanh toán chuyển khoản</h1>
    <p class="page-subtitle">Quét mã QR và chuyển khoản — hệ thống sẽ tự xác nhận khi nhận được tiền</p>
</div>

<div id="paymentWaitingAlert" class="alert alert-warning d-flex align-items-center gap-2">
    <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
    <span id="paymentStatusText">Đang chờ xác nhận chuyển khoản từ ngân hàng...</span>
</div>

<div id="paymentSuccessAlert" class="alert alert-success d-none">
    <i class="bi bi-check-circle-fill me-1"></i>
    <span id="paymentSuccessText">Thanh toán thành công! Đang chuyển hướng...</span>
</div>

<div class="row g-4" id="paymentContent">
    <div class="col-lg-5">
        <div class="content-card text-center h-100">
            <div class="card-header"><i class="bi bi-qr-code me-1"></i> Mã QR thanh toán</div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.QrCodeImageUrl))
                {
                    <img src="@Model.QrCodeImageUrl" alt="VietQR" class="img-fluid rounded border mb-3" style="max-width:280px;" />
                    <p class="small text-muted mb-0">Quét bằng app ngân hàng / VietQR</p>
                }
                else
                {
                    <img src="@Model.QrCodeDataUri" alt="QR chuyển khoản" class="img-fluid rounded border mb-3" style="max-width:280px;" />
                    <p class="small text-muted mb-0">Quét mã QR để xem thông tin chuyển khoản</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="content-card h-100">
            <div class="card-header"><i class="bi bi-bank me-1"></i> Thông tin chuyển khoản</div>
            <div class="card-body">
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-4">Hóa đơn</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.InvoiceCode</dd>

                    <dt class="col-sm-4">Số tiền</dt>
                    <dd class="col-sm-8">
                        <span class="fs-4 fw-bold text-primary">@Model.TotalAmount.ToString("N0") đ</span>
                    </dd>

                    <dt class="col-sm-4">Ngân hàng</dt>
                    <dd class="col-sm-8">@Model.BankName</dd>

                    <dt class="col-sm-4">Chi nhánh</dt>
                    <dd class="col-sm-8">@Model.Branch</dd>

                    <dt class="col-sm-4">Số tài khoản</dt>
                    <dd class="col-sm-8">
                        <span class="fw-semibold" id="accountNumber">@Model.AccountNumber</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="copyText('accountNumber')">
                            <i class="bi bi-clipboard"></i> Sao chép
                        </button>
                    </dd>

                    <dt class="col-sm-4">Chủ tài khoản</dt>
                    <dd class="col-sm-8">@Model.AccountName</dd>

                    <dt class="col-sm-4">Nội dung CK</dt>
                    <dd class="col-sm-8">
                        <span class="fw-semibold text-danger" id="transferContent">@Model.TransferContent</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="copyText('transferContent')">
                            <i class="bi bi-clipboard"></i> Sao chép
                        </button>
                    </dd>
                </dl>

                <div class="alert alert-info mt-4 mb-0 small">
                    <i class="bi bi-info-circle me-1"></i>
                    Chuyển khoản <strong>đúng số tiền</strong> và <strong>đúng nội dung</strong>.
                    Sau khi ngân hàng xác nhận, trang này sẽ tự chuyển sang trạng thái <strong>Đã thanh toán</strong>.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mt-4">
    <a asp-action="Pay" asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary btn-sm">Đổi phương thức</a>
    <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-primary btn-sm">Xem hóa đơn</a>
</div>

@section Scripts {
<script>
    var invoiceId = @Model.InvoiceId;
    var pollTimer = null;

    function copyText(elementId) {
        var text = document.getElementById(elementId).innerText.trim();
        navigator.clipboard.writeText(text).then(function () {
            alert('Đã sao chép: ' + text);
        });
    }

    function checkPaymentStatus() {
        $.get('@Url.Action("PaymentStatus", "Invoices")', { id: invoiceId }, function (data) {
            $('#paymentStatusText').text(data.message || 'Đang chờ...');

            if (data.status === 'Paid') {
                clearInterval(pollTimer);
                $('#paymentWaitingAlert').addClass('d-none');
                $('#paymentSuccessAlert').removeClass('d-none');
                $('#paymentSuccessText').text(data.message);
                setTimeout(function () {
                    window.location.href = data.redirectUrl || '@Url.Action("Details", new { id = Model.InvoiceId })';
                }, 2000);
            } else if (data.status === 'Expired') {
                clearInterval(pollTimer);
                $('#paymentWaitingAlert').removeClass('alert-warning').addClass('alert-danger');
                $('#paymentWaitingAlert .spinner-border').remove();
            }
        });
    }

    pollTimer = setInterval(checkPaymentStatus, 3000);
    checkPaymentStatus();
</script>
}

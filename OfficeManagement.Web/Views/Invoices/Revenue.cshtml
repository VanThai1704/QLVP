@model IEnumerable<RevenueStatItem>
@{ ViewData["Title"] = "Thống kê doanh thu"; }
<h2>Thống kê doanh thu</h2>
<p class="lead">Tổng doanh thu: <strong>@(((decimal?)ViewBag.TotalRevenue ?? 0).ToString("N0")) VNĐ</strong></p>
<table class="table table-striped col-md-6">
    <thead><tr><th>Kỳ</th><th class="text-end">Số tiền (VNĐ)</th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr><td>@s.Period</td><td class="text-end">@s.Amount.ToString("N0")</td></tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="2" class="text-muted">Chưa có dữ liệu.</td></tr>
    }
    </tbody>
</table>
